+#if defined(_MSC_VER)
+#define GL_WEAK
+#define CLOCK_MONOTONIC 1
+#define CLOCK_REALTIME 2
+static int gl_clock_gettime(int clock_id, struct timespec *ts)
+{
+    if (clock_id == CLOCK_REALTIME)
+        return timespec_get(ts, TIME_UTC) == TIME_UTC ? 0 : -1;
+    Uint64 ticks = SDL_GetPerformanceCounter(), frequency = SDL_GetPerformanceFrequency();
+    if (!frequency) return -1;
+    ts->tv_sec = (time_t)(ticks / frequency);
+    ts->tv_nsec = (long)((ticks % frequency) * 1000000000ull / frequency);
+    return 0;
+}
+#define clock_gettime gl_clock_gettime
+#else
+#define GL_WEAK __attribute__((weak))
+#endif
