+
+int nv2a_gl_readback(uint32_t va, uint32_t *pixels, size_t capacity,
+                     uint32_t *width, uint32_t *height)
+{
+    GlSurf *s = surf_find(va);
+    if (s_state != 1 || !s || !pixels || !width || !height)
+        return 0;
+    *width = s->pw; *height = s->ph;
+    if ((uint64_t)s->pw * s->ph > capacity)
+        return 0;
+    glFinish();
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, s->fbo);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glReadPixels(0, 0, (GLsizei)s->pw, (GLsizei)s->ph,
+                 GL_BGRA, GL_UNSIGNED_BYTE, pixels);
+    GLenum error = glGetError();
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    return error == GL_NO_ERROR;
 }
 
