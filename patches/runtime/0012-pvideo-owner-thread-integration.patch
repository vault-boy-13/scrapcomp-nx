     fprintf(stderr, "  [GL] NV2A OpenGL renderer registered\n");
 }
+
+#include "nv2a_overlay.h"
+int nv2a_gl_present_overlay(const uint32_t *pixels, uint32_t width, uint32_t height,
+                            uint32_t logical_width, uint32_t logical_height)
+{
+    static GlSurf overlay;
+#if !defined(_WIN32)
+    if (s_q_on) return 0; /* queued ownership requires a copied video command */
+#endif
+    if (!pixels || !width || !height || !logical_width || !logical_height || !ready())
+        return 0;
+    state_dirty();
+    if (!overlay.tex) {
+        glGenTextures(1, &overlay.tex);
+        glGenFramebuffers(1, &overlay.fbo);
+    }
+    glBindTexture(GL_TEXTURE_2D, overlay.tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, (GLsizei)width, (GLsizei)height,
+                 0, GL_BGRA, GL_UNSIGNED_BYTE, pixels);
+    glBindFramebuffer(GL_FRAMEBUFFER, overlay.fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, overlay.tex, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+        return 0;
+    overlay.w = logical_width; overlay.h = logical_height;
+    overlay.pw = width; overlay.ph = height;
+    overlay.aa_sx = overlay.aa_sy = 1;
+    GlSurf *previous_surface = s_last;
+    int previous_drawn = s_drew_any;
+    s_last = &overlay; s_drew_any = 1;
+    gl_flip();
+    s_last = previous_surface; s_drew_any = previous_drawn;
+    state_dirty();
+    return glGetError() == GL_NO_ERROR;
+}
