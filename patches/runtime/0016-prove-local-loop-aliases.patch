+"""Preserve a secondary guest entry while sharing the complete owner CFG."""
+
+
+def validate_retained_entries(subject, actual, entries, local_aliases):
+    entries = list(entries)
+    if entries != sorted(set(entries)) or not set(entries).issubset(actual):
+        raise ValueError('retained_entries must be sorted unique interior starts')
+    if set(entries).intersection(local_aliases):
+        raise ValueError('a retained entry cannot also be removed as a local alias')
+    for entry in entries:
+        info = subject.func_db[entry]
+        if (info.get('detection_method') not in {'tail_jump_alias', 'imm_ref_target'}
+                or info.get('has_prologue')):
+            raise ValueError('retained entry must be a secondary tail entry without its own prologue')
+    return set(entries)
+
+
+def validate_retained_cfg(entries, instructions):
+    by_address = {i.address: i for i in instructions}
+    if not entries.issubset(by_address):
+        raise ValueError('retained entry is not an instruction in the proven owner CFG')
+    from .translator import _FLAG_READERS
+    # The incoming EFLAGS snapshot is not represented in this donor ABI.
+    # Reject an entry that observes it. Full flag writers or a normal call
+    # establish the same boundary used by the donor's recovered-arm check.
+    writers = {'cmp', 'test', 'and', 'or', 'xor', 'add', 'sub', 'neg',
+               'comiss', 'ucomiss', 'comisd', 'ucomisd',
+               'fcomi', 'fcomip', 'fcompi', 'fucomi', 'fucomip', 'fucompi'}
+    for entry in entries:
+        pending = [entry]
+        seen = set()
+        while pending:
+            pc = pending.pop()
+            if pc in seen:
+                continue
+            seen.add(pc)
+            ins = by_address.get(pc)
+            if ins is None:
+                raise ValueError('retained entry leaves the proven CFG before defining flags')
+            if (ins.mnemonic in _FLAG_READERS or ins.is_cond_jump
+                    or ins.mnemonic.startswith(('set', 'cmov', 'fcmov'))):
+                raise ValueError('retained entry requires unrepresented incoming flags')
+            if ins.mnemonic in writers or ins.is_call or ins.is_ret:
+                continue
+            if ins.is_jump:
+                if ins.jump_target is None:
+                    raise ValueError('retained entry has an unproved initial indirect jump')
+                pending.append(ins.jump_target)
+            else:
+                pending.append(ins.end_address)
+
+
+def entry_wrapper(name, owner, entry):
+    helper = f'recomp_shared_{owner:08X}'
+    return (f'extern void {helper}(uint32_t entry);\n'
+            f'void {name}(void) {{ {helper}(0x{entry:08X}u); }}\n')
+
+
+def shared_body(code, name, owner, entries):
+    if not entries:
+        return code
+    helper = f'recomp_shared_{owner:08X}'
+    signature = f'void {name}(void)'
+    if code.count(signature) != 1:
+        raise ValueError('unexpected owner signature while retaining entries')
+    code = code.replace(signature, f'void {helper}(uint32_t _entry)', 1)
+    label = f'loc_{owner:08X}: ;'
+    dispatch = []
+    for entry in sorted(entries):
+        if f'loc_{entry:08X}: ;' not in code:
+            raise ValueError('retained entry label is absent from generated owner')
+        dispatch.append(f'    if (_entry == 0x{entry:08X}u) goto loc_{entry:08X};')
+    if code.count(label) != 1:
+        raise ValueError('owner label is absent while retaining entries')
+    code = code.replace(label, '\n'.join(dispatch) + '\n' + label, 1)
+    return code + '\n' + entry_wrapper(name, owner, owner)
