+"""Classify raw address bytes only inside independently reached instructions."""
+import struct
+from . import config
+from .disasm import Disassembler
+
+
+def has_absolute_reference(subject, alias, recovery_start, recovery_end):
+    needle = struct.pack('<I', alias)
+    offset = 0
+    while True:
+        offset = subject.xbe_data.find(needle, offset)
+        if offset < 0:
+            return False
+        occurrence = offset
+        offset += 1
+        sections = [s for s in config._SECTIONS if s.is_code
+                    and s.raw_addr <= occurrence
+                    and occurrence + 4 <= s.raw_addr + s.raw_size]
+        if len(sections) != 1:
+            return True
+        section = sections[0]
+        va = section.va + occurrence - section.raw_addr
+        owners = [(a, info) for a, info in subject.func_db.items()
+                  if a <= va and va + 4 <= info.get('end', a)
+                  and (info.get('detection_method') == 'call_target'
+                       or (info.get('detection_method') == 'prologue'
+                           and info.get('has_prologue')))
+                  and info.get('called_by')
+                  and (info.get('end', a) <= recovery_start or a >= recovery_end)]
+        if len(owners) != 1:
+            return True
+        start, info = owners[0]
+        end = info['end']
+        if not section.va <= start < end <= section.va + section.raw_size:
+            return True
+        if end - start > 65536:
+            return True
+        begin = section.raw_addr + start - section.va
+        # A separately called frame-prologue root is independent evidence too,
+        # but verify the original PUSH EBP/MOV EBP,ESP bytes in addition to
+        # metadata. Weak, uncalled and speculative roots remain disallowed.
+        if info.get('detection_method') == 'prologue' and subject.xbe_data[begin:begin+3] not in (
+                b'\x55\x8B\xEC', b'\x55\x89\xE5'):
+            return True
+        instructions = Disassembler().disassemble_cfg(
+            subject.xbe_data[begin:begin + end - start], start, end, [start])
+        containing = [i for i in instructions if i.address <= va and va + 4 <= i.end_address]
+        if len(containing) != 1:
+            return True
+        instruction = containing[0]
+        # A genuine immediate/absolute displacement still rejects recovery.
+        # Only unrelated opcode/ModRM/relative-displacement byte collisions
+        # can pass. Data, undecoded gaps and cross-instruction matches fail.
+        if alias in instruction.imm_values or alias in instruction.memory_refs:
+            return True
+        if any(op.type == 'mem' and op.mem_disp == alias for op in instruction.operands):
+            return True
