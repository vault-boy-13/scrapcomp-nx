+"""Conservative opt-in proof for tail aliases caused by an owner's split loop."""
+import struct
+from . import config
+from .non_pointer import has_absolute_reference
+
+
+def validate_local_aliases(subject, target, end, actual, aliases):
+    aliases = list(aliases)
+    if aliases != sorted(set(aliases)) or not set(aliases).issubset(actual):
+        raise ValueError("local_aliases must be sorted unique interior starts")
+    for alias in aliases:
+        info = subject.func_db[alias]
+        if (info.get("detection_method") != "tail_jump_alias"
+                or info.get("called_by") or info.get("has_prologue")
+                or info.get("external_entry")
+                or alias in subject.protected_function_starts
+                or alias in subject.coalesced_function_starts):
+            raise ValueError(f"local alias 0x{alias:08X} has independent evidence")
+        if has_absolute_reference(subject, alias, target, end):
+            raise ValueError(f"local alias 0x{alias:08X} has an absolute reference")
+    if not aliases:
+        return set()
+    selected = set(aliases)
+    # Examine every code byte, including currently undiscovered functions.
+    # A false-positive opcode inside an immediate rejects the proposal;
+    # it must never justify discarding a possible external entry.
+    forms = [(op, 5, 1, 4) for op in (0xE8, 0xE9)]
+    forms += [(op, 2, 1, 1) for op in (0xEB, *range(0x70, 0x80), *range(0xE0, 0xE4))]
+    forms += [(0x0F, 6, 2, 4)]
+    for section in config._SECTIONS:
+        if not section.is_code:
+            continue
+        raw = subject.xbe_data[section.raw_addr:section.raw_addr + section.raw_size]
+        for opcode, length, displacement_offset, width in forms:
+            cursor = 0
+            while True:
+                index = raw.find(bytes([opcode]), cursor)
+                if index < 0:
+                    break
+                cursor = index + 1
+                if index + length > len(raw):
+                    continue
+                if opcode == 0x0F and not 0x80 <= raw[index + 1] <= 0x8F:
+                    continue
+                source = section.va + index
+                displacement = int.from_bytes(
+                    raw[index + displacement_offset:index + displacement_offset + width],
+                    "little", signed=True)
+                destination = (source + length + displacement) & 0xFFFFFFFF
+                if destination in selected and (opcode == 0xE8 or not target <= source < end):
+                    raise ValueError(
+                        f"local alias 0x{destination:08X} has a possible external/call reference at 0x{source:08X}")
+    return selected
+
+
+def validate_local_jumps(aliases, instructions):
+    targets = {instruction.jump_target for instruction in instructions
+               if instruction.is_branch}
+    if not aliases.issubset(targets):
+        raise ValueError("local alias lacks a decoded owner jump")
