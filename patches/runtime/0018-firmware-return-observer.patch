+ * The observer must not alter guest state or suppress termination. */
+#ifndef XBOX_FIRMWARE_OBSERVER_H
+#define XBOX_FIRMWARE_OBSERVER_H
+#include <stdint.h>
+typedef void (*xbox_firmware_observer)(uint32_t routine);
