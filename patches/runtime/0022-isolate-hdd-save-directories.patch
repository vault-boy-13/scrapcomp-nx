+/* Bare directory rules match themselves or descendants, not similarly
+ * named siblings (UDATA2, Partition30). Consume an optional separator. */
+static int match_rule(const char *path, const char *prefix)
+{
+    int n = match_prefix(path, prefix);
+    if (n && prefix[n-1] != '\\') {
+        if (path[n] && path[n] != '\\') return 0;
+        if (path[n] == '\\') n++;
+    }
+    return n;
+}
