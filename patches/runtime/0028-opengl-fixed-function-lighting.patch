+/* NV097 fixed-function lighting uniforms. SPDX-License-Identifier: MIT
+ * Uniform transport follows Manhunt's gl_lighting.h (c) 2026 sp00nz;
+ * expanded here for inverse normals, spot cones and separate specular. */
+#ifndef NV2A_GL_LIGHTING_H
+#define NV2A_GL_LIGHTING_H
+#include <stdint.h>
+#include <string.h>
+#define NV2A_FFP_ROWS 84
+static inline void nv2a_gl_ffp_uniforms(const uint32_t *r, int enabled, float u[NV2A_FFP_ROWS][4])
+{
+    memset(u,0,NV2A_FFP_ROWS*16);
+    if(!enabled) return;
+    u[0][0]=1;u[0][1]=(float)!!r[0x3A4/4];u[0][2]=(float)!!r[0x3B8/4];u[0][3]=(float)r[0x294/4];
+    memcpy(u[1],r+0xA10/4,12);memcpy(&u[1][3],r+0x3B4/4,4);
+    memcpy(u[2],r+0x9E0/4,12);u[2][3]=(float)r[0x298/4];
+    memcpy(u[3],r+0x3A8/4,12);
+    memcpy(u[4],r+0xA50/4,16);
+    memcpy(u[5],r+0x480/4,64);memcpy(u[9],r+0x580/4,48);
+    for(int i=0;i<8;++i) {
+        unsigned b=(0x1000+i*0x80)/4,row=12+i*9;
+        memcpy(u[row],r+b,12);u[row][3]=(float)((r[0x3BC/4]>>(i*2))&3);
+        memcpy(u[row+1],r+b+0x0C/4,12);memcpy(&u[row+1][3],r+b+0x24/4,4);
+        memcpy(u[row+2],r+b+0x18/4,12);
+        memcpy(u[row+3],r+b+0x34/4,12);memcpy(u[row+4],r+b+0x28/4,12);
+        memcpy(u[row+5],r+b+0x5C/4,12);memcpy(u[row+6],r+b+0x68/4,12);
+        memcpy(u[row+7],r+b+0x40/4,12);memcpy(u[row+8],r+b+0x4C/4,16);
+    }
+}
+#endif
