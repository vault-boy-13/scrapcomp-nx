+        "void nv2a_ffp_colors(vec4 pos, vec4 normal, vec4 diffuse, vec4 specular, out vec4 d0, out vec4 d1) {\n"
+        "    if(u_ffp[0].x==0.0) { d0=diffuse; d1=specular; return; }\n"
+        "    vec4 ep; vec3 n;\n"
+        "    for(int k=0;k<4;++k) ep[k]=dot(u_ffp[5+k],pos);\n"
+        "    for(int k=0;k<3;++k) n[k]=dot(u_ffp[9+k].xyz,normal.xyz);\n"
+        "    if(u_ffp[0].y!=0.0) n=ffp_unit(n);\n"
+        "    int cm=int(u_ffp[2].w), ctl=int(u_ffp[0].w);\n"
+        "    int es=cm&3, am=(cm>>2)&3, ds=(cm>>4)&3, ss=(cm>>6)&3;\n"
+        "    vec3 em=ffp_material(es,diffuse,specular), amb=ffp_material(am,diffuse,specular);\n"
+        "    vec3 dm=ffp_material(ds,diffuse,specular), sm=ffp_material(ss,diffuse,specular);\n"
+        "    float alpha=ds==0?u_ffp[1].a:ds==1?diffuse.a:specular.a;\n"
+        "    vec3 color=(es==0 || am==0)?u_ffp[1].rgb:em;\n"
+        "    if(es!=0 && am!=0) color+=amb*u_ffp[3].rgb;\n"
+        "    else if(es!=0) color+=em*u_ffp[3].rgb;\n"
+        "    else if(am!=0) color+=amb*u_ffp[3].rgb;\n"
+        "    vec3 shiny=vec3(0.0);\n"
+        "    vec3 eye=(ctl&65536)!=0?ffp_unit(u_ffp[4].xyz/u_ffp[4].w-ep.xyz/ep.w):vec3(0.0);\n"
+        "    for(int i=0;i<8;++i) {\n"
