diff --git a/src/usb/ohci.c b/src/usb/ohci.c
--- a/src/usb/ohci.c
+++ b/src/usb/ohci.c
@@ -832,8 +832,15 @@ static void ohci_publish_done(OhciController *hc, uint32_t done_head)
         if (t)
             wr32(t + 8, held);
     }
     hc->reg[HcDoneHead / 4] = done_head;
+#if !defined(__SWITCH__)
     ohci_flush_done(hc);
+#endif
+    /* On Switch, publish at the end of the controller tick. If a periodic
