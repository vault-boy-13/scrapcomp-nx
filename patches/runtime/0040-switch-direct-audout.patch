+static int submit_audout(const int16_t *samples, size_t bytes)
+{
+    AudioOutBuffer *buffer = &g_audout_buffers[(g_audout_head + g_audout_pending) % AUDOUT_SLOTS];
+    memcpy(buffer->buffer, samples, bytes);
+    buffer->data_size = bytes;
+    armDCacheFlush(buffer->buffer, bytes);
+    Result rc = audoutAppendAudioOutBuffer(buffer);
+    if (R_FAILED(rc)) {
+        audout_error("append", rc);
+        return 0;
+    }
+    ++g_audout_pending;
+    return 1;
+}
