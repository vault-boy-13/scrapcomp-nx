+static int open_audout(void)
+{
+    Result rc = audoutInitialize();
+    if (R_FAILED(rc)) {
+        audout_error("initialize", rc);
+        return 0;
+    }
+    if (audoutGetSampleRate() != SDLA_SAMPLE_RATE ||
+        audoutGetChannelCount() != SDLA_CHANNELS ||
+        audoutGetPcmFormat() != PcmFormat_Int16) {
+        fprintf(stderr, "[AUDIO] Unexpected audout format\n");
+        audoutExit();
+        return 0;
+    }
+    unsigned char *memory = memalign(AUDOUT_PAGE_BYTES, AUDOUT_SLOTS * AUDOUT_PAGE_BYTES);
+    if (!memory) {
+        fprintf(stderr, "[AUDIO] could not allocate the audout buffer pool\n");
+        audoutExit();
+        return 0;
+    }
+    rc = audoutStartAudioOut();
+    if (R_FAILED(rc)) {
+        audout_error("start", rc);
+        audoutExit();
+        free(memory);
+        return 0;
+    }
+    g_audout_memory = memory;
+    g_audout_head = g_audout_pending = 0;
+    g_audout_poll_at = 0;
+    for (int i = 0; i < AUDOUT_SLOTS; ++i) {
+        g_audout_buffers[i] = (AudioOutBuffer){
+            .buffer = memory + i * AUDOUT_PAGE_BYTES,
+            .buffer_size = AUDOUT_PAGE_BYTES,
+        };
+    }
+    fprintf(stderr, "[AUDIO] audout: %d Hz, %d ch, queue %d x %d samples\n",
+            SDLA_SAMPLE_RATE, SDLA_CHANNELS, g_sdla_target, SDLA_BLOCK_SAMPLES);
+    return 1;
+}
