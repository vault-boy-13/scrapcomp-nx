+            AudioOutBuffer *released = NULL;
+            u32 count = 0;
+            Result rc = audoutGetReleasedAudioOutBuffer(&released, &count);
+            if (R_FAILED(rc)) {
+                audout_error("get released buffer", rc);
+                break;
+            }
+            if (!count) break;
+            if (count != 1 || released != &g_audout_buffers[g_audout_head]) {
+                if (!g_audout_error_logged) {
+                    g_audout_error_logged = true;
+                    fprintf(stderr, "[AUDIO] audout released an unexpected buffer\n");
+                }
+                break;
+            }
+            g_audout_head = (g_audout_head + 1) % AUDOUT_SLOTS;
+            --g_audout_pending;
+        }
+    }
+    return g_audout_pending;
+#else
     if (!g_sdla_dev) return 0;
